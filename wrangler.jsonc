{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lhl-festas",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "keep_vars": true,
  "services": [
    { "binding": "MAIL_RECEIVER", "service": "lhl-email-receiver" }
  ],
  "observability": {
    "enabled": true
  }
}
