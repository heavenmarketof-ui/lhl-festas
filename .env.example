# Variáveis públicas do frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Variáveis privadas do servidor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GAS_SHARED_TOKEN=

# Fonte temporária do catálogo. Quando o catálogo for totalmente migrado,
# esta variável poderá apontar para a nova origem sem alterar o frontend.
CATALOGO_PUBLIC_URL=

# Preview local do Admin permanece somente leitura por padrão.
# Defina como true apenas quando houver intenção explícita de habilitar mutations no desenvolvimento.
VITE_ADMIN_WRITES=false
