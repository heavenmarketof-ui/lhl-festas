# Variáveis públicas do frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identificação pública oficial da LHL Festas
VITE_LHL_CNPJ=66.067.187/0001-59

# Variáveis privadas do servidor
# A chave usada pelo servidor é a publishable/anon do MESMO projeto do frontend.
# Não usar service_role no Worker para este fluxo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Apps Script / Google Sheets
# Não colocar valores reais neste arquivo; configurar como secrets do ambiente.
GAS_ENDPOINT_URL=
GAS_SHARED_TOKEN=
GAS_LEADS_ADMIN_TOKEN=

# Preview local do Admin permanece somente leitura por padrão.
# Defina como true apenas quando houver intenção explícita de habilitar mutations no desenvolvimento.
VITE_ADMIN_WRITES=false
